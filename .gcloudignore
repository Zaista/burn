.gcloudignore
.git
.gitignore
.idea
.claude

# cloudbuild.yaml's backend-deploy step (`gcloud run deploy --source .`)
# deploys the backend only (src/ -> dist/, compiled during Cloud Run's
# buildpack build via the gcp-build script). The my-app/ frontend is a
# separate deployable (its own --source my-app deploy) and isn't needed
# here.
my-app/
private/
node_modules/
dist/
*.md
